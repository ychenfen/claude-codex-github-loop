# Raw datasets and model weights NEVER enter the repository; derived summaries in data/derived/ are allowed
data/*
!data/derived/
datasets/
raw/
experiments/**/data/
experiments/**/models/
experiments/**/checkpoints/
*.pkl
*.pickle
*.feather
*.db
*.sqlite
*.sqlite3
*.zip
*.7z
*.rar
*.gz
*.tar
*.bz2
*.parquet
*.h5
*.hdf5
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.bin
*.npy
*.npz

# Full logs are uploaded to ephemeral artifacts; only agent_tail.log is kept in git
*.log
!runs/*/agent_tail.log

# Local environment & credentials
config/local_paths.json
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
__pycache__/
.venv/
venv/
node_modules/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.DS_Store
